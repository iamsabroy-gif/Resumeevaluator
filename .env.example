# Copy to .env for local dev, or set these in the Netlify site UI
# (Site settings → Environment variables) for deployment.

# Enables real AI drafting. Without it the app uses the deterministic offline
# stub, so the site still works end to end with no key.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Force real Anthropic drafting on ("anthropic") or the stub ("stub").
# Auto-detected from ANTHROPIC_API_KEY when unset.
# AI_PROVIDER=

# Optional: YouTube Data API v3 key for rich study tutorial search on missing skills.
# Without it the app seamlessly falls back to direct YouTube search URLs.
YOUTUBE_API_KEY=

# Optional. Force the Netlify Blobs store locally (e.g. under `netlify dev`).
# On Netlify itself this is auto-enabled via the NETLIFY env var.
# USE_NETLIFY_BLOBS=true

# Strongly-consistent Blobs reads (required for the deployed app).
# The app chains write-then-read across function invocations, which the
# eventual-consistency edge context breaks. Set a Netlify personal access token
# and the site id so the store talks to the strongly-consistent Blobs API.
# Set these in the Netlify site environment, not in the repo.
# NETLIFY_BLOBS_TOKEN=nfp_your_personal_access_token
# NETLIFY_BLOBS_SITE_ID=your-site-id   # falls back to Netlify's built-in SITE_ID

# Optional: Custom local data persistence directory (defaults to ./.data)
# RESUME_EVALUATOR_DATA_DIR=./.data
