{
  "name": "resume-evaluator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ATS resume scoring and human-in-the-loop rewriting app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run-all.ts",
    "test:acceptance": "tsx tests/acceptance-tests.ts",
    "test:evidence": "tsx tests/evidence-weighting-tests.ts",
    "test:pipeline": "tsx tests/pipeline-tests.ts",
    "smoke": "tsx tests/smoke-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "cheerio": "^1.2.0",
    "express": "^4.21.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
